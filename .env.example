# ==========================================================
# باصنا — إعدادات البيئة. انسخ هذا الملف إلى .env ولا ترفع .env للمستودع.
# كلمات المرور هنا للتطوير المحلي فقط — غيّرها في أي بيئة أخرى.
# ==========================================================
NODE_ENV=development
PORT=4000

# --- قاعدة البيانات (PostgreSQL 14+) ---
# أسماء الأدوار busna_app / busna_auth / busna_worker ثابتة لأن سياسات RLS تشير إليها.
# DATABASE_ADMIN_URL مطلوب فقط لسكربت db:bootstrap في التطوير.
DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/postgres
DATABASE_OWNER_URL=postgres://busna_owner:dev_owner_pw@localhost:5432/busna_dev
DATABASE_APP_URL=postgres://busna_app:dev_app_pw@localhost:5432/busna_dev
DATABASE_AUTH_URL=postgres://busna_auth:dev_auth_pw@localhost:5432/busna_dev
DATABASE_WORKER_URL=postgres://busna_worker:dev_worker_pw@localhost:5432/busna_dev

# --- المصادقة ---
# ولّد قيمة عشوائية: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_generate_a_random_value_of_at_least_32_chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
INVITE_TTL_DAYS=7

# --- الروابط ---
APP_PUBLIC_URL=http://localhost:5173
APP_SCHEME=busna
CORS_ORIGINS=http://localhost:5173

# --- إشعارات الجوال ---
# none: تُحفظ الإشعارات داخل التطبيق فقط. expo: الإرسال عبر Expo Push Service
# (يتطلب بناء التطبيق عبر EAS مع إعداد FCM لأندرويد وAPNs لـ iOS).
PUSH_PROVIDER=none
# EXPO_ACCESS_TOKEN=   # مطلوب فقط إذا فعّلت "Enhanced push security" في حساب Expo

# --- الوقت التقديري للوصول ---
# estimate: تقدير تقريبي داخلي (مسافة + سرعة الباص) بلا خدمة خارجية ولا مفاتيح — يوسم دائمًا «تقديري»
# osrm: خادم OSRM يتبع الطرق الفعلية (ضع OSRM_URL، ويفضّل استضافته ذاتيًا) — none: إخفاء وقت الوصول
ROUTING_PROVIDER=estimate
# OSRM_URL=https://osrm.example.com

# --- «مساعد باصنا» (الذكاء الاصطناعي) ---
# none: المساعد معطّل — يعمل البحث في قاعدة المعرفة والتذاكر والطوارئ فقط.
# anthropic: يتطلب ANTHROPIC_API_KEY (من console.anthropic.com). المفتاح يبقى في الخادم فقط.
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high — عمق التفكير مقابل التكلفة والسرعة
AI_EFFORT=medium

WORKER_ENABLED=true
